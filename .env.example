# Copy to .env and fill in. NEVER commit .env - it is in .gitignore for a reason.
#
# These three come from: AWS access portal > Accounts tab > expand SandboxAccount
# > Access keys > "Option 1: Set AWS environment variables".
#
# THEY EXPIRE EVERY 12 HOURS. When boto3 starts returning
# ExpiredTokenException or InvalidClientTokenId, that is all this is. Log back
# into the access portal and copy the three values again.
#
# AWS_SESSION_TOKEN is required. These are temporary STS credentials, not a
# permanent IAM user, and boto3 fails with a confusing auth error if you paste
# only the first two.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# The organisers' guide is explicit: Bedrock access is granted in us-east-1.
# If you see "Access denied to bedrock:ListFoundationModels", you are in the
# wrong region, not missing a permission.
AWS_REGION=us-east-1

# Fill these in after running: python scripts/verify_aws.py
# Paste the exact ids that script prints. Do not guess or copy from a blog post.
MODEL_HAIKU=
MODEL_SONNET=

# Created during the deploy spike. Must be globally unique.
S3_BUCKET=
